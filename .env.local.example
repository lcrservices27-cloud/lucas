# Conectar com `vercel link` + `vercel env pull .env.local` depois de criar o projeto
# na Vercel e adicionar o storage Postgres (Neon). A variável pode vir como DATABASE_URL
# ou POSTGRES_URL dependendo da integração — confira o .env.local gerado e ajuste lib/db.js
# se o nome vier diferente.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Login do dashboard (usuário único, o fundador)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# String aleatória longa (ex: `openssl rand -hex 32`), usada para assinar o cookie de sessão
SESSION_SECRET=
