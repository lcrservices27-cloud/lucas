# Banco de dados — PostgreSQL
#
# Produção (Vercel): use um Postgres gerenciado. Exemplos:
#   Neon:            postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
#   Supabase:        postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Vercel Postgres: (copie a env POSTGRES_PRISMA_URL gerada e cole aqui)
#
# Desenvolvimento local: um Postgres via Docker (uma linha):
#   docker run --name fin-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# e use:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# NextAuth
# Gere um segredo com:  openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte-de-32-bytes"
# Em produção, defina a URL pública do app:
NEXTAUTH_URL="http://localhost:3000"
