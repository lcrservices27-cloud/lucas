# Banco de dados
# Desenvolvimento (SQLite):
DATABASE_URL="file:./dev.db"
#
# Produção (Vercel) — use um Postgres gerenciado (Neon, Supabase, Vercel Postgres)
# ou Turso. Exemplo Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Gere um segredo com:  openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte-de-32-bytes"
# Em produção, defina a URL pública do app:
NEXTAUTH_URL="http://localhost:3000"
